# Core runtime
APP_ENV=dev
DATABASE_PATH=data/youtube_comments.db
COMPLIANCE_REFERENCE=IRB: IRB-2026-045 (University X)
SPAM_RULESET_VERSION=v1.0.0
RAW_RETENTION_DAYS=180

# Extraction controls
EXECUTION_MODE=auto
API_DAILY_QUOTA=10000
API_FAILOVER_THRESHOLD=0.90

# Local auth for Streamlit multi-user mode (format: user:password,user2:password2)
LOCAL_AUTH_USERS=annotator_a:change_me,annotator_b:change_me,adjudicator:change_me

# Optional API credentials
YOUTUBE_API_KEY=
YOUTUBE_API_KEYS=
HASH_SALT=change_me_to_a_long_random_secret
